class Solution {
public:
bool check(int mid,vector<int>& weights, int days){
    int n = weights.size();
    int m = mid;
    int count = 1;
    for(int i  = 0;i<n;i++){
        if(m>= weights[i]){
            m = m-weights[i];
        }
        else{
            count++;
            m = mid;
         m = m-weights[i];
        }
    }
      if(count>days) return false ;
        else return true;
}
    int shipWithinDays(vector<int>& weights, int days) {
        int n = weights.size();
        int max  = INT_MIN;
        int sum = 0;
        for(int i = 0;i<n;i++){
            if(max<weights[i]) max = weights[i];
            sum = sum+weights[i];
        }

        int l = max;
        int h = sum;
        int minCapicity = sum;
        while(l<=h){
            int mid = l+(h-l)/2;
            if(check(mid,weights,days)){
                minCapicity = mid;
                h = mid-1;
            }
            else l = mid +1;
        }
       return minCapicity;
    }
};
